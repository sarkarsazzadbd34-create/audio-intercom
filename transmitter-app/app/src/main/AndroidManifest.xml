<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Mic capture -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Required to run a foreground service that captures the mic (Android 14+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Visible notification while streaming -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Networking -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <uses-feature android:name="android.hardware.microphone" android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Audio Transmitter"
        android:theme="@style/Theme.AudioTx"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AudioTx">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground service that owns the microphone + WebRTC PeerConnection.
             foregroundServiceType="microphone" is mandatory on Android 14+ for
             any service that uses the mic while the app is backgrounded, and it
             is exactly what forces the persistent notification to appear. -->
        <service
            android:name=".TransmitterService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

    </application>
</manifest>
